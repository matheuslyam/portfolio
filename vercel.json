{
  "rewrites": [
    {
      "source": "/the-knight-game",
      "destination": "https://knightgame-nine.vercel.app/"
    },
    {
      "source": "/the-knight-game/",
      "destination": "https://knightgame-nine.vercel.app/"
    },
    {
      "source": "/the-knight-game/:path*",
      "destination": "https://knightgame-nine.vercel.app/:path*"
    }
  ],

  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/the-knight-game",
      "destination": "/the-knight-game/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://lyam.dev.br/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "portfolio-nine-phi-pa4vx3qgn1.vercel.app" }]
    }
  ]
}